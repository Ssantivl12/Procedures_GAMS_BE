generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  SUPERADMIN
  ENCARGADO
  SECRETARIA
  INSPECTOR
}

enum CompanyCategory {
  C3
  C4
}

enum ProcedureTypeCode {
  RAI
  MAI_PMA
  IAA
  CIERRE
}

enum ProcedureKind {
  NUEVO
  RENOVACION
}

enum ProcedureStatus {
  RECIBIDO
  EN_REVISION
  OBSERVADO_PENDIENTE_RECOJO
  SUBSANACION_PENDIENTE_REINGRESO
  CERRADO
  ABANDONADO
}

enum DocumentGroup {
  INGRESO
  ANEXO
  OBSERVACIONES
  REINGRESO
  ACTA
  INFORME
  RESULTADO_FINAL
  OTRO
}

enum ObservationCategory {
  DOCUMENTAL
  TECNICA
  ADMINISTRATIVA
  LEGAL
  OTRA
}

enum ObservationPriority {
  ALTA
  MEDIA
  BAJA
}

model Role {
  id        String   @id @default(uuid())
  name      RoleName @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  users UserRole[]

  @@map("role")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  isActive     Boolean   @default(true)
  deletedAt    DateTime? @db.Timestamptz(6)

  lastLoginAt DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)

  roles              UserRole[]
  createdProcedures  Procedure[]      @relation("ProcedureCreatedBy")
  assignedProcedures Procedure[]      @relation("ProcedureAssignedInspector")
  audits             ProcedureAudit[] @relation("ProcedureAuditChangedBy")
  refreshTokens      RefreshToken[]   @relation("UserRefreshTokens")
  auditLogs          AuditLog[]       @relation("UserAuditLogs")
  issuedObservations   Observation[] @relation("ObservationIssuedBy")
  resolvedObservations Observation[] @relation("ObservationResolvedBy")
  uploadedDocuments    Document[]

  @@map("user")
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime  @default(now()) @db.Timestamptz(6)
  revokedAt  DateTime? @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_role")
}

enum District {
  DISTRITO_1
  DISTRITO_2
  DISTRITO_3
  DISTRITO_4
  DISTRITO_5
  DISTRITO_6
  DISTRITO_7
  DISTRITO_LAVA_LAVA
  DISTRITO_CHINATA
}

enum GeoZone {
  Urbano
  Rural
}

enum UtmZone {
  ZONE_19K
  ZONE_20K
}

enum EffluentDisposal {
  PTAR
  PTAR_ALCANTARILLADO
  ALCANTARILLADO_COOPERATIVA
  POZO_SEPTICO
  OTRO
}

enum SolidWasteDisposal {
  GERES
  TERCIARIZACION
  GERES_TERCIARIZACION
  OTRO
}

enum WaterSupply {
  POZO_DE_AGUA
  RED_DE_AGUA_COOPERATIVA
  CISTERNA
  EMAPAS
  POZO_COOPERATIVA
  OTROS
}

model Company {
  id           String          @id @default(uuid())

  legalName    String                       
  nit          String?         @unique
  raiNumber    String?         @unique
  category     CompanyCategory
  address      String?
  phone        String?                       
  legalRepName String?
  legalRepCi   String?
  caebCodes    String[]
  economicActivity String?
  municipality String?
  email        String?
  observations String?

  businessClass               String?      
  district                    District?      
  geoZone                     GeoZone?       
  utmZone                     UtmZone?       
  coordinates                 String?       

  effluentDisposal            EffluentDisposal?       
  solidWasteDisposal          SolidWasteDisposal?      

  useHazardousSubstances      Boolean?      @default(false)
  hazardousSubstancesDescription String?
  usesMercury                 Boolean?      @default(false)

  rawMaterials                Json?         
  finalProducts               Json?        

  usedArea                    Float?        
  areaUnit                    String?       

  waterSupply                 WaterSupply?       
  installedPower              Float?        

  isActive  Boolean   @default(true)
  deletedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  caseFile CaseFile?

  @@index([legalName])
  @@map("company")
}

model CaseFile {
  id         String    @id @default(uuid())
  companyId  String    @unique
  code       String?   @unique
  fileNumber String?   @unique
  openedAt   DateTime  @default(now()) @db.Timestamptz(6)
  closedAt   DateTime? @db.Timestamptz(6)

  isActive  Boolean   @default(true)
  deletedAt DateTime? @db.Timestamptz(6)

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  procedures Procedure[]

  @@map("case_file")
}

model ProcedureType {
  id                 Int               @id @default(autoincrement())
  code               ProcedureTypeCode @unique
  name               String
  allowsObservations Boolean           @default(true)
  allowsReentry      Boolean           @default(true)

  procedures Procedure[]

  @@map("procedure_type")
}

model Procedure {
  id              String          @id @default(uuid())
  caseFileId      String
  procedureTypeId Int
  procedureKind   ProcedureKind
  currentStatus   ProcedureStatus @default(RECIBIDO)
  cycleCount      Int             @default(0)

  receptionDate   DateTime  @db.Date
  reviewStartDate DateTime? @db.Date
  obsPickedDate   DateTime? @db.Date

  deadlineDate        DateTime? @db.Date
  daysElapsed         Int?      @default(0)
  isOverdue           Boolean   @default(false)
  routeSheetNumber    String?
  internalFileNumber  String?
  approvalDate        DateTime? @db.Date
  approvalCertificate String?
  expirationDate      DateTime? @db.Date
  maxReentriesAllowed Int       @default(1)
  reentryCount        Int       @default(0)
  generalNotes        String?

  closedAt DateTime? @db.Timestamptz(6)

  createdByUserId         String
  assignedInspectorUserId String?

  abandonReason String?

  isActive  Boolean   @default(true)
  deletedAt DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  caseFile      CaseFile      @relation(fields: [caseFileId], references: [id], onDelete: Restrict)
  procedureType ProcedureType @relation(fields: [procedureTypeId], references: [id], onDelete: Restrict)

  createdBy         User  @relation("ProcedureCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  assignedInspector User? @relation("ProcedureAssignedInspector", fields: [assignedInspectorUserId], references: [id], onDelete: Restrict)

  audits       ProcedureAudit[]
  cycles       ProcedureCycle[]
  observations Observation[]
  documents    Document[]

  @@index([caseFileId, procedureTypeId, currentStatus])
  @@index([currentStatus, assignedInspectorUserId])
  @@index([receptionDate])
  @@index([deadlineDate])
  @@map("procedure")
}

model ProcedureAudit {
  id              String           @id @default(uuid())
  procedureId     String
  fromStatus      ProcedureStatus?
  toStatus        ProcedureStatus
  changedByUserId String
  changedAt       DateTime         @default(now()) @db.Timestamptz(6)
  note            String?

  procedure Procedure @relation(fields: [procedureId], references: [id], onDelete: Restrict)
  changedBy User      @relation("ProcedureAuditChangedBy", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([procedureId, changedAt])
  @@map("procedure_audit")
}

model ProcedureCycle {
  id          String    @id @default(uuid())
  procedureId String
  cycleNumber Int
  openedAt    DateTime  @default(now()) @db.Timestamptz(6)
  closedAt    DateTime? @db.Timestamptz(6)
  note        String?

  reentryDate    DateTime? @db.Date
  reviewDeadline DateTime? @db.Date

  isActive  Boolean   @default(true)
  deletedAt DateTime? @db.Timestamptz(6)

  procedure    Procedure     @relation(fields: [procedureId], references: [id], onDelete: Restrict)
  observations Observation[]
  documents    Document[]

  @@unique([procedureId, cycleNumber])
  @@index([procedureId])
  @@map("procedure_cycle")
}

model Observation {
  id             String   @id @default(uuid())
  procedureId    String
  cycleId        String?
  summary        String
  details        String?
  isResolved     Boolean  @default(false)
  issuedAt       DateTime @default(now()) @db.Timestamptz(6)
  issuedByUserId String

  category         ObservationCategory?
  priority         ObservationPriority?
  resolvedAt       DateTime? @db.Timestamptz(6)
  resolvedByUserId String?
  resolutionNote   String?

  isActive  Boolean   @default(true)
  deletedAt DateTime? @db.Timestamptz(6)

  procedure  Procedure       @relation(fields: [procedureId], references: [id], onDelete: Restrict)
  cycle      ProcedureCycle? @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  issuedBy   User            @relation("ObservationIssuedBy", fields: [issuedByUserId], references: [id], onDelete: Restrict)
  resolvedBy User?           @relation("ObservationResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([procedureId, issuedAt])
  @@map("observation")
}

model Document {
  id          String        @id @default(uuid())
  procedureId String
  cycleId     String?
  docGroup    DocumentGroup
  fileName    String
  storageKey  String
  mimeType    String

  fileSize         BigInt?
  description      String?
  originalFileName String?
  checksum         String?
  isLatest         Boolean  @default(true)
  replacedById     String?
  version          Int      @default(1)
  uploadedByUserId String
  uploadedAt       DateTime @default(now()) @db.Timestamptz(6)

  isActive  Boolean   @default(true)
  deletedAt DateTime? @db.Timestamptz(6)

  procedure  Procedure       @relation(fields: [procedureId], references: [id], onDelete: Restrict)
  cycle      ProcedureCycle? @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  uploadedBy User            @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  @@unique([procedureId, docGroup, version])
  @@index([procedureId, docGroup])
  @@index([uploadedAt])
  @@map("document")
}

// ==============================
// authetication and auditLogs
// ==============================

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  expiresAt DateTime  @db.Timestamptz(6)
  revoked   Boolean   @default(false)
  revokedAt DateTime? @db.Timestamptz(6)
  ip        String?
  userAgent String?
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation("UserRefreshTokens", fields: [userId], references: [id], onDelete: NoAction)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_token")
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  userId    String?
  details   Json?
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  user User? @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@map("audit_log")
}

model DeadlineConfig {
  id            Int               @id @default(autoincrement())
  procedureType ProcedureTypeCode
  cycleNumber   Int
  deadlineDays  Int
  description   String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@unique([procedureType, cycleNumber])
  @@map("deadline_config")
}

model NonWorkingDay {
  id          Int      @id @default(autoincrement())
  date        DateTime @db.Date
  description String?
  type        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  createdBy   String?

  @@unique([date])
  @@index([date])
  @@map("non_working_day")
}
